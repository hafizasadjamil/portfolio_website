# Copy this file to .env and fill it in. Never commit .env.
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/DATABASE
# Long random value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Sites allowed to call the API, comma separated.
# localhost:3000, localhost:3001 and asadjamil.tech are always allowed.
FRONTEND_URL=
ADMIN_URL=

# Optional: email a copy of contact messages (Gmail address + app password).
EMAIL_USER=
EMAIL_PASS=

# Optional: folder on a persistent volume for uploaded images.
UPLOADS_DIR=

# Optional: use these DNS servers if MongoDB fails with "querySrv ECONNREFUSED".
DNS_SERVERS=

# Optional: Python command for the job scraper (python on Windows, python3 elsewhere).
PYTHON_BIN=
